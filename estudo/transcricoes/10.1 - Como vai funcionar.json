[{"s": 0.0, "e": 3.12, "t": "Nessa aula, a gente vai aprender a criar esse motion aqui."}, {"s": 3.12, "e": 6.64, "t": "Tenha um burger que é feito na chata, coitado."}, {"s": 6.64, "e": 9.12, "t": "O nosso vai por fogo."}, {"s": 9.12, "e": 10.88, "t": "Fogo de verdade."}, {"s": 10.88, "e": 12.36, "t": "Carne de verdade."}, {"s": 12.36, "e": 13.8, "t": "Frescura?"}, {"s": 13.8, "e": 15.36, "t": "A gente leva a sério."}, {"s": 15.36, "e": 16.4, "t": "E do seu jeito."}, {"s": 16.4, "e": 18.72, "t": "Sem cebola, com bacon."}, {"s": 18.72, "e": 20.2, "t": "Carne dobrada."}, {"s": 20.2, "e": 23.8, "t": "Pede no app, pega o cupom e diz adeus pra fila."}, {"s": 23.8, "e": 25.96, "t": "Afinal, quem é rei?"}, {"s": 25.96, "e": 26.96, "t": "É rei."}, {"s": 26.96, "e": 32.58, "t": "Quer aprender a fazer um motion desse?"}, {"s": 32.58, "e": 36.14, "t": "Eu ensino no curso Motion com Iá, que tá na black agora."}, {"s": 36.14, "e": 38.58, "t": "Comenta burger e olha teu direct."}]