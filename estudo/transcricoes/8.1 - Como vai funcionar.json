[{"s": 0.0, "e": 3.2, "t": "Nessa aula, a gente vai aprender a criar esse monster aqui."}, {"s": 3.2, "e": 6.2, "t": "400!"}, {"s": 6.2, "e": 8.4, "t": "Tu acha que é só energético?"}, {"s": 8.4, "e": 9.9, "t": "Leu rótomo de novo."}, {"s": 9.9, "e": 12.8, "t": "Cafeína? Mais 3 horas de foco."}, {"s": 12.8, "e": 15.5, "t": "Taurina? Coragem pra segunda-feira."}, {"s": 15.5, "e": 17.7, "t": "Gin-sang? Gás pro treino."}, {"s": 17.7, "e": 20.2, "t": "Guaraná? Reflexo de pro-player."}, {"s": 20.2, "e": 23.6, "t": "Açúcar? A vontade de terminar o que começou."}, {"s": 23.6, "e": 25.3, "t": "Não é só energético."}, {"s": 25.3, "e": 28.6, "t": "Ela tá acabou."}, {"s": 28.6, "e": 29.8, "t": "O gás não."}, {"s": 29.8, "e": 32.3, "t": "Monster. Unleash the beast."}]